{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "project.requirements output",
  "description": "Submitted as a JSON string. A later code.orchestrate-pr step writes files[] verbatim (SHARED-project-folder.md).",
  "type": "object",
  "required": ["slug", "files", "summary", "featureIds"],
  "properties": {
    "slug": { "type": "string" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "content"],
        "properties": {
          "path": { "type": "string", "pattern": "^docs/projects/[a-z0-9]+(-[a-z0-9]+)*/[^/.][^/]*(/[^/.][^/]*)*$", "description": "Repo-relative, under docs/projects/<slug>/." },
          "content": { "type": "string", "description": "The whole file." }
        },
        "additionalProperties": false
      }
    },
    "summary": { "type": "string" },
    "featureIds": { "type": "array", "items": { "type": "string" }, "description": "Every id in the written features.json not marked dropped." }
  },
  "additionalProperties": false
}
