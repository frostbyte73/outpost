#!/usr/bin/env node
// Drop-in replacement for `claude` during e2e tests. Reads OUTPOST_TEST_FIXTURE (a JSONL
// file path), emits each line to stdout in stream-json shape, optionally pacing.
//
// Speaks the Agent SDK's stdio control protocol: it answers the SDK's `initialize`, and before
// emitting an assistant message with a tool_use it asks the SDK's PreToolUse hook callback over
// a `hook_callback` control request. A deny suppresses the call with a deny tool_result.
//
// Special marker lines (not emitted, control-only):
//   {"_marker":"wait-for-input"} — pause until the next user message arrives on stdin
//   {"_marker":"stop-hook"}      — fire the SDK's Stop hook callback
//   {"_marker":"exit"}            — exit immediately (skip any remaining fixture lines)

import { appendFileSync, readFileSync, writeFileSync } from 'node:fs';
import { setTimeout as sleep } from 'node:timers/promises';

const argv = process.argv.slice(2);
// The SDK passes `--flag=value`.
function flagValue(name) {
  return argv.find((a) => a.startsWith(`${name}=`))?.slice(name.length + 1);
}
const sessionId = flagValue('--session-id') ?? flagValue('--resume') ?? 'unknown';

const fixturePath = process.env.OUTPOST_TEST_FIXTURE;
if (!fixturePath) {
  process.stderr.write('[mock claude] OUTPOST_TEST_FIXTURE not set\n');
  process.exit(1);
}

const lines = readFileSync(fixturePath, 'utf8').split('\n').filter(Boolean);
const delayMs = Number(process.env.OUTPOST_TEST_DELAY_MS ?? 5);

// OUTPOST_TEST_STDIN_LOG: append every user message received on stdin, so a test can assert on
// exactly what the daemon sent claude. Control traffic is not logged.
const stdinLog = process.env.OUTPOST_TEST_STDIN_LOG;

// OUTPOST_TEST_HOOK_ACCESS_FILE: write the hook server's port and secret, which only a spawned session is handed.
if (process.env.OUTPOST_TEST_HOOK_ACCESS_FILE) {
  writeFileSync(process.env.OUTPOST_TEST_HOOK_ACCESS_FILE, JSON.stringify({
    port: process.env.OUTPOST_HOOK_PORT, secret: process.env.DAEMON_AUTH,
  }));
}

const hookIds = {};
let markInitialized;
const initialized = new Promise((resolve) => { markInitialized = resolve; });
const pending = new Map();
let nextRequest = 0;

function write(obj) {
  process.stdout.write(JSON.stringify(obj) + '\n');
}

function onControlRequest(msg) {
  const req = msg.request ?? {};
  let response = {};
  if (req.subtype === 'initialize') {
    for (const [event, matchers] of Object.entries(req.hooks ?? {})) {
      hookIds[event] = matchers.flatMap((m) => m.hookCallbackIds ?? []);
    }
    // The SDK refuses to start a session with onFailure:'block' hooks unless the CLI says it honors them.
    response = { hook_on_failure_supported: true };
    markInitialized();
  }
  write({ type: 'control_response', response: { subtype: 'success', request_id: msg.request_id, response } });
}

process.stdin.setEncoding('utf8');
const stdinQueue = [];
let stdinResolver = null;
// A long line (a message carrying a photo) arrives over several chunks; only a newline ends
// it, or one message would count as several inputs.
let partial = '';
process.stdin.on('data', (chunk) => {
  const parts = (partial + chunk).split('\n');
  partial = parts.pop();
  for (const line of parts) {
    if (!line) continue;
    let msg;
    try { msg = JSON.parse(line); } catch { msg = null; }
    if (msg?.type === 'control_request') { onControlRequest(msg); continue; }
    if (msg?.type === 'control_response') {
      const resolve = pending.get(msg.response?.request_id);
      pending.delete(msg.response?.request_id);
      resolve?.(msg.response);
      continue;
    }
    if (msg?.type === 'control_cancel_request') continue;
    stdinQueue.push(line);
    if (stdinLog) appendFileSync(stdinLog, line + '\n');
  }
  if (stdinQueue.length && stdinResolver) { const r = stdinResolver; stdinResolver = null; r(); }
});

async function readStdinLine() {
  while (stdinQueue.length === 0) {
    await new Promise((resolve) => { stdinResolver = resolve; });
  }
  return stdinQueue.shift();
}

async function callHook(event, input, toolUseId) {
  await initialized;
  const callbackId = hookIds[event]?.[0];
  if (!callbackId) return undefined;
  const requestId = `mock_${nextRequest++}`;
  const answered = new Promise((resolve) => pending.set(requestId, resolve));
  write({
    type: 'control_request',
    request_id: requestId,
    request: { subtype: 'hook_callback', callback_id: callbackId, input: { hook_event_name: event, session_id: sessionId, ...input }, tool_use_id: toolUseId },
  });
  const res = await answered;
  return res?.subtype === 'success' ? res.response : undefined;
}

// The PreToolUse decision for one tool_use block; no registered hook means allow, so tests that
// don't care about approvals still work.
async function firePreToolUseHook(toolUse) {
  const out = await callHook('PreToolUse', { tool_name: toolUse.name, tool_input: toolUse.input, tool_use_id: toolUse.id }, toolUse.id);
  return out?.hookSpecificOutput ?? { permissionDecision: 'allow' };
}

// Synthesize a user-role message containing a deny tool_result. Mirrors what real claude
// inserts into the conversation after a denied PreToolUse hook.
function denyToolResult(toolUse, reason) {
  return {
    type: 'user',
    session_id: sessionId,
    message: {
      role: 'user',
      content: [{
        type: 'tool_result',
        tool_use_id: toolUse.id,
        content: reason ?? 'Tool use rejected by user',
        is_error: true,
      }],
    },
  };
}

async function main() {
  for (const raw of lines) {
    let parsed;
    try { parsed = JSON.parse(raw); } catch { continue; }
    if (parsed._marker === 'wait-for-input') { await readStdinLine(); continue; }
    if (parsed._marker === 'stop-hook') { await callHook('Stop', { stop_hook_active: false }); continue; }
    if (parsed._marker === 'exit') { process.exit(0); }
    if (parsed.session_id === undefined && (parsed.type === 'system' || parsed.type === 'assistant' || parsed.type === 'user')) {
      parsed.session_id = sessionId;
    }
    // Inject cwd into the system init record so SessionStore.findSession can resolve the
    // session's working directory (used by project-scoped allowlist lookup). Real claude
    // writes cwd into every record; we only need it on the first one the store sees.
    if (parsed.type === 'system' && parsed.subtype === 'init' && parsed.cwd === undefined) {
      parsed.cwd = process.cwd();
    }

    // If this assistant message contains tool_use blocks, fire the hook for each one
    // BEFORE emitting. If any are denied, emit a synthetic deny tool_result instead.
    if (parsed.type === 'assistant' && Array.isArray(parsed.message?.content)) {
      const toolUses = parsed.message.content.filter((b) => b?.type === 'tool_use');
      let denied = null;
      for (const tu of toolUses) {
        const decision = await firePreToolUseHook(tu);
        if (decision.permissionDecision === 'deny') {
          denied = { toolUse: tu, reason: decision.permissionDecisionReason };
          break;
        }
      }
      if (denied) {
        // Real claude would still emit the assistant tool_use line (so the transcript
        // shows what was attempted) and then a deny tool_result. Match that shape.
        write(parsed);
        await sleep(delayMs);
        write(denyToolResult(denied.toolUse, denied.reason));
        await sleep(delayMs);
        continue;
      }
    }

    write(parsed);
    await sleep(delayMs);
  }
}

main().catch((e) => {
  process.stderr.write(`[mock claude] ${e?.stack ?? e}\n`);
  process.exit(1);
});
